#!/usr/bin/env python3
"""Local systemctl/appctl interface backed by an actual daemon and HTTP health check."""
import subprocess,sys,os,json,time,signal,urllib.request
from pathlib import Path
PID=Path('/var/run/demo-app.pid')
args=sys.argv[1:]
if os.geteuid()!=0:raise SystemExit('root is required to manage the system unit')
if not args or args[0] not in ('start','restart','status'):raise SystemExit('usage: systemctl start|restart|status app')
op=urllib.request.build_opener(urllib.request.ProxyHandler({}))
if args[0]=='restart' and PID.exists():
    try:os.kill(int(PID.read_text()),signal.SIGTERM)
    except ProcessLookupError:pass
    time.sleep(.3)
if args[0] in ('start','restart'):
    logfile=open('/var/log/demo-app.log','ab')
    proc=subprocess.Popen(['runuser','-u','app','--','python3','/srv/demo-app.py'],stdout=logfile,stderr=logfile,start_new_session=True)
    for _ in range(40):
        try:
            data=json.load(op.open('http://127.0.0.1:8765/health',timeout=.2));PID.write_text(str(data['pid']));print(json.dumps(data));break
        except Exception:
            if proc.poll() is not None:raise SystemExit('service failed; see /var/log/demo-app.log')
            time.sleep(.1)
    else:raise SystemExit('service did not become healthy')
else:print(op.open('http://127.0.0.1:8765/health',timeout=2).read().decode())
