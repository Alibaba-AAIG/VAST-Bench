BILLINGRELAY_PUBLISHABLE_KEY=EXAMPLE_VALUE_FOR_BILLINGRELAY_PUBLISHABLE_KEY
NEXT_PUBLIC_API_BASE=https://base.billing-demo.example.test
SDK_ENV=sample-base
