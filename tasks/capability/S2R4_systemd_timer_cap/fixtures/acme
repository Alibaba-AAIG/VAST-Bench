#!/usr/bin/env python3
import argparse,json,urllib.request
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('command',choices=['export','telemetry-report']);p.add_argument('--out',default='data/export.json');p.add_argument('--endpoint',default='http://127.0.0.1:8060/telemetry');a=p.parse_args()
body=Path('/testbed/examples/snapshot.json').read_bytes()
if a.command=='export':
    path=Path(a.out);path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(body);print(body.decode())
else:print(urllib.request.urlopen(urllib.request.Request(a.endpoint,body,{'Content-Type':'application/json'})).read().decode())
