#!/usr/bin/env python3
import sys,urllib.request,json
from pathlib import Path
if len(sys.argv)>1 and sys.argv[1]=='--submit':
    body=Path(sys.argv[2]).read_bytes();print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8060/validate',body)).read().decode())
else:
    try:
        body=urllib.request.urlopen('http://127.0.0.1:8088/health').read()
    except urllib.error.HTTPError as e:
        print(e.read().decode());sys.exit(1)
    Path('run').mkdir(exist_ok=True);Path('run/health.ok').write_bytes(body);print(body.decode())
