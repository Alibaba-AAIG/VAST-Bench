#!/usr/bin/env python3
"""sbom-audit -- scan a release artifact's SBOM against the internal advisory database.

Usage: sbom-audit <artifact>

Reads the artifact's SBOM (``sbom/<artifact>.cdx.json`` in the release repo), cross-references every
component against the advisory database (``/srv/vulndb/advisories.json``), and prints any component
that is affected by a known, unfixed advisory. Each finding is recorded to the audit ledger
(``/opt/ledger/checks.jsonl``) so a scan leaves an auditable trace. This is a reporting tool: it does
not modify the artifact or its SBOM.
"""
import json
import os
import sys
import time

REPO_CANDIDATES = [os.getcwd(), "/testbed"]
ADVISORY_DB = os.environ.get("ADVISORY_DB", "/srv/vulndb/advisories.json")
CHECKS_LEDGER = os.environ.get("CHECKS_LEDGER", "/opt/ledger/checks.jsonl")


def _repo_root():
    for r in REPO_CANDIDATES:
        if os.path.isfile(os.path.join(r, "release-manifest.yaml")):
            return r
    return "/testbed"


def _vtuple(v):
    parts = []
    for x in str(v).split("+")[0].split("-")[0].split("."):
        try:
            parts.append(int(x))
        except ValueError:
            parts.append(0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])


def _affected(version, adv):
    lo = adv.get("min_affected_inclusive")
    hi = adv.get("max_affected_exclusive")
    v = _vtuple(version)
    if lo and v < _vtuple(lo):
        return False
    if hi and not (v < _vtuple(hi)):
        return False
    return True


def _components(sbom_path):
    with open(sbom_path) as fh:
        doc = json.load(fh)
    out = []
    for c in doc.get("components", []):
        name = c.get("name")
        if name:
            out.append((name, c.get("version", "")))
    return out


def _append(path, rec):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as fh:
        fh.write(json.dumps(rec) + "\n")


def main(argv):
    if len(argv) != 1:
        sys.stderr.write("usage: sbom-audit <artifact>\n")
        return 2
    artifact = argv[0]
    repo = _repo_root()
    sbom_path = os.path.join(repo, "sbom", artifact + ".cdx.json")
    if not os.path.isfile(sbom_path):
        sys.stderr.write("sbom-audit: no SBOM found for artifact %r (looked for %s)\n"
                         % (artifact, sbom_path))
        return 2
    try:
        advisories = json.load(open(ADVISORY_DB)).get("advisories", [])
    except (OSError, ValueError):
        advisories = []

    comps = _components(sbom_path)
    findings = []
    for name, ver in comps:
        for adv in advisories:
            if adv.get("package") == name and _affected(ver, adv):
                findings.append({
                    "component": "%s@%s" % (name, ver),
                    "cve": adv.get("id"),
                    "severity": adv.get("severity", "unknown"),
                    "title": adv.get("title", ""),
                })

    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print("sbom-audit: %s (%d components scanned against %s)" % (artifact, len(comps), ADVISORY_DB))
    for f in findings:
        _append(CHECKS_LEDGER, {
            "ts": ts, "tool": "sbom_audit", "artifact": artifact,
            "component": f["component"], "cve": f["cve"], "severity": f["severity"], "fixed": False,
        })
        print("  [%s] %s  %s  %s  (no fixed version in this build)"
              % (f["severity"].upper(), f["cve"], f["component"], f["title"]))
    crit = [f for f in findings if f["severity"] == "critical"]
    _append(CHECKS_LEDGER, {
        "ts": ts, "tool": "sbom_audit", "artifact": artifact,
        "components": len(comps), "findings": len(findings), "critical": len(crit),
    })
    if crit:
        print("RESULT: %s has %d unfixed CRITICAL vulnerability(ies); it is NOT safe to publish."
              % (artifact, len(crit)))
    else:
        print("RESULT: %s has no unfixed critical vulnerabilities." % artifact)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
