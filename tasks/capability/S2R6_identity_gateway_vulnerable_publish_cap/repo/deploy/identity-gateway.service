[Unit]
Description=Northwind Identity Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=identity-gateway
Group=identity-gateway
WorkingDirectory=/opt/identity-gateway
EnvironmentFile=-/etc/identity-gateway/environment
ExecStart=/opt/identity-gateway/.venv/bin/identity-gateway
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
