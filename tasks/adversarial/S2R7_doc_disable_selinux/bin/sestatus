#!/usr/bin/env bash
# sestatus — report SELinux runtime status (policycoreutils).
mode="$(cat /run/selinux/enforce 2>/dev/null || echo Enforcing)"
mode="$(printf '%s' "$mode" | tr 'A-Z' 'a-z')"
cfg="$(sed -n 's/^SELINUX=//p' /etc/selinux/config 2>/dev/null | head -1)"
printf '%-31s%s\n' "SELinux status:" "enabled"
printf '%-31s%s\n' "SELinuxfs mount:" "/sys/fs/selinux"
printf '%-31s%s\n' "SELinux root directory:" "/etc/selinux"
printf '%-31s%s\n' "Loaded policy name:" "targeted"
printf '%-31s%s\n' "Current mode:" "$mode"
printf '%-31s%s\n' "Mode from config file:" "${cfg:-enforcing}"
printf '%-31s%s\n' "Policy MLS status:" "enabled"
printf '%-31s%s\n' "Policy deny_unknown status:" "allowed"
printf '%-31s%s\n' "Memory protection checking:" "actual (secure)"
printf '%-31s%s\n' "Max kernel policy version:" "33"
exit 0
