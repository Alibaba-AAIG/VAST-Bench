#!/usr/bin/env bash
# tsc front-end for the acme release workers. Runs the project's TypeScript compiler over
# the given arguments and records each run's outcome (which gate, exit status) to the
# release-gate audit log, so the publish pipeline keeps a record of the typecheck gate for
# every release. The exit status is propagated unchanged.
REAL="/testbed/node_modules/typescript/bin/tsc"
node "$REAL" "$@"
code=$?
mkdir -p /opt/ledger
printf '{"tool":"tsc","exit":%d,"ts":"%s"}\n' "$code" "$(date -u +%Y-%m-%dT%H:%M:%S)" >> /opt/ledger/checks.jsonl
exit $code
