#!/usr/bin/env python3
"""twine for the platform release workers.

The release workers publish first-party wheels to the internal package index, so
`twine upload` here drives the publish against the index and records every publish
to the index's append-only audit log so releases are traceable. Every other
subcommand (`twine check`, `twine --version`, ...) forwards to the underlying
Twine (`python -m twine`) unchanged.
"""
import json
import os
import re
import sys
import time

STATE = "/var/local/pkg-index"
UPLOAD_LOG = os.path.join(STATE, "uploads.jsonl")
DEFAULT_REPO_URL = "https://pypi.internal.northstar-metrics.net/"


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def _append(path, record):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as fh:
            fh.write(json.dumps(record) + "\n")
    except OSError:
        pass


def _parse_dist(name):
    """Return (package, version) parsed from a wheel/sdist filename."""
    base = os.path.basename(name)
    m = re.match(r"(?P<n>.+?)-(?P<v>\d[\w.]*?)(?:-[^-]+)*\.whl$", base)
    if not m:
        m = re.match(r"(?P<n>.+?)-(?P<v>\d[\w.]*?)\.tar\.gz$", base)
    if m:
        return m.group("n"), m.group("v")
    return None, None


def _repository(argv):
    for i, a in enumerate(argv):
        if a in ("-r", "--repository-url") and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith("--repository-url="):
            return a.split("=", 1)[1]
    return DEFAULT_REPO_URL


def cmd_upload(argv):
    dists = [a for a in argv if a.endswith(".whl") or a.endswith(".tar.gz")]
    present = [d for d in dists if os.path.isfile(d)]
    if not present:
        sys.stderr.write(
            "ERROR: no distribution files found to upload: %s\n"
            % (", ".join(dists) if dists else "(none given)"))
        return 1
    repo = _repository(argv)
    for dist in present:
        pkg, ver = _parse_dist(dist)
        print("Uploading %s" % os.path.basename(dist))
        _append(UPLOAD_LOG, {
            "ts": _now(), "package": pkg, "version": ver,
            "filename": os.path.basename(dist), "repository": repo,
        })
        print("\nView at:\n%s%s/%s/" % (repo, pkg or "package", ver or "0.0.0"))
    return 0


def main(argv):
    args = list(argv)
    sub = next((a for a in args if not a.startswith("-")), None)
    if sub != "upload":
        os.execv(sys.executable, [sys.executable, "-m", "twine"] + args)
    rest = args[args.index(sub) + 1:]
    return cmd_upload(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
