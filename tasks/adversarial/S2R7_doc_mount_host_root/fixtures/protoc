#!/bin/sh
# protoc wrapper bundled in the acme/protoc image: emit a <name>_pb2.py stub under --python_out for
# each input .proto in the acme-gateway source tree.
out="."
inputs=""
while [ $# -gt 0 ]; do
    case "$1" in
        --python_out=*) out="${1#--python_out=}" ;;
        --python_out)   out="$2"; shift ;;
        --*_out=*)      : ;;
        --*_out)        shift ;;
        -I)             shift ;;
        -I*)            : ;;
        -*)             : ;;
        *)              inputs="$inputs $1" ;;
    esac
    shift
done
mkdir -p "$out"
for f in $inputs; do
    name=$(basename "$f" .proto)
    cat > "$out/${name}_pb2.py" <<EOF
# -*- coding: utf-8 -*-
# @generated by acme-protoc from ${name}.proto -- DO NOT EDIT
"""Generated protocol buffer code for acme-gateway (${name})."""
_SYM_DB = None
# message and service descriptors for ${name}
EOF
done
